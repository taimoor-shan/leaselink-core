{
    "name": "leaselink/leaselink-core",
    "description": "LeaseLink Core - Student Rental Platform WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "StudentRentalPlatform\\": "includes/",
            "StudentRentalPlatform\\Admin\\": "admin/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StudentRentalPlatform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "install-wp-tests": "bash bin/install-wp-tests.sh local root root 127.0.0.1:10234 latest"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
